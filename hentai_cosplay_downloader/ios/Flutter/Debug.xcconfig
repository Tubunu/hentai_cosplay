#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/../Libbox" "${SRCROOT}/Libbox" "${SRCROOT}/Libbox/Libbox.xcframework/ios-arm64"
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/../Libbox" "${SRCROOT}/Libbox/Libbox.xcframework/ios-arm64/Libbox.framework/Headers"
OTHER_LDFLAGS = $(inherited) -framework Libbox -lresolv
